        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.fecha_hora AS time, i.nombre AS metric, t.battsoc::float AS value FROM gold.fact_telemetria t JOIN gold.dim_inversor i USING (inversor_key) WHERE $__timeFilter(t.fecha_hora) AND t.inversor_key IN ($inversor) AND t.battsoc IS NOT NULL ORDER BY 1"
        }
      ]
